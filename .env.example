GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Leads

# GOOGLE_MAPS_API_KEY la usan DOS funciones con requisitos distintos:
# - api/reviews.js la llama desde el servidor (Places API New). Debe tener
#   restricción de aplicación "Ninguna" -- con restricción por referente,
#   Google rechaza cualquier llamada de servidor.
# - api/maps-key.js se la sirve al navegador para el mapa interactivo
#   (Maps JavaScript API). Debe tener esa API permitida en la misma clave.
# GOOGLE_PLACE_ID admite el Place ID canónico ("ChIJ...") o el par
# hexadecimal "0x<fid>:0x<cid>" que aparece en las URLs de Google Maps.
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACE_ID=
GOOGLE_PLACE_QUERY=
