GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Leads

# Reseñas de Google (api/reviews.js). Solo la usa el servidor, nunca llega
# al navegador -- debe llevar restricción de aplicación "Ninguna" (con
# restricción por referente, Google rechaza cualquier llamada de servidor,
# que no manda cabecera "referer") y restricción de API a Places API (New).
#
# GOOGLE_PLACE_ID admite el Place ID canónico ("ChIJ...") o el par
# hexadecimal "0x<fid>:0x<cid>" que aparece en las URLs de Google Maps.
#
# El mapa de "Ubicación" ya NO usa ninguna clave: es un iframe de
# solo-dirección (sin API de Google JavaScript), justo para no depender de
# que ninguna clave/restricción esté bien configurada en Google Cloud.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
GOOGLE_PLACE_QUERY=
