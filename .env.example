GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Leads

# Dos claves de Google Maps Platform, con restricciones OPUESTAS a
# propósito -- no vale reutilizar la misma para las dos cosas:
#
# GOOGLE_MAPS_API_KEY: api/maps-key.js se la sirve al navegador para el
#   mapa interactivo (Maps JavaScript API). Debe llevar restricción de
#   aplicación por referente HTTP al dominio del sitio -- queda visible en
#   el tráfico de red de cualquier visitante, así que sin esa restricción
#   cualquiera podría copiarla y usarla desde otro sitio a tu costa.
#
# GOOGLE_PLACES_API_KEY: api/reviews.js la llama solo desde el servidor
#   (Places API New), nunca llega al navegador. Debe llevar restricción de
#   aplicación "Ninguna" -- con restricción por referente, Google rechaza
#   cualquier llamada de servidor (no manda cabecera "referer").
#
# GOOGLE_PLACE_ID admite el Place ID canónico ("ChIJ...") o el par
# hexadecimal "0x<fid>:0x<cid>" que aparece en las URLs de Google Maps.
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
GOOGLE_PLACE_QUERY=
